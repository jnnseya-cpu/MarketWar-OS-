{
  "name": "marketwar-os",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "jose": "^5.10.0"
  },
  "description": "MarketWar OS \u2014 AI-powered growth and commerce operating system: discover opportunities, create and market products, acquire customers, automate operations, optimise revenue, and scale from one unified platform.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "smoke:live": "node scripts/smoke-live.mjs",
    "seed:accounts": "node scripts/seed-accounts.mjs",
    "verify": "npm run check:layers && npm run check:casts && npm run typecheck && npm run build",
    "check:layers": "node scripts/check-layers.mjs",
    "check:casts": "node scripts/check-casts.mjs",
    "test": "NODE_ENV=test node --import tsx --test tests/*.test.mjs",
    "splash": "node scripts/generate-splash.mjs",
    "social": "node scripts/build-social-assets.mjs",
    "gtm:doc": "node scripts/build-gtm-doc.mjs && node scripts/verify-gtm-doc.mjs",
    "gtm:verify": "node scripts/verify-gtm-doc.mjs",
    "ads:doc": "node --import tsx scripts/build-ads-doc.mjs && node --import tsx scripts/verify-ads-doc.mjs",
    "ads:verify": "node --import tsx scripts/verify-ads-doc.mjs",
    "pitch:doc": "node --import tsx scripts/build-pitch-doc.mjs && node --import tsx scripts/verify-pitch-doc.mjs",
    "pitch:verify": "node --import tsx scripts/verify-pitch-doc.mjs"
  },
  "dependencies": {
    "firebase": "^12.16.0",
    "firebase-admin": "^14.1.0",
    "lucide-react": "^0.469.0",
    "next": "^14.2.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.20",
    "docx": "^9.7.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2"
  }
}
